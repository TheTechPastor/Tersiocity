}{\plain \fs24 \b\f1 Human Nature}{\plain \fs24 \f1 \par
}{\plain \fs24 \f1   \par
}\pard \fs24\s1\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 Q.\ul0 \tab  What are we by nature? \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 A. \ul0 \tab We are part of God{\u8217\'92}s creation, made in the image of God.\par
}\pard \fs24\sl120\slmult1\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1  \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 Q. \ul0 \tab What does it mean to be created in the image of God? \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 A. \ul0 \tab It means that we are free to make choices: to love, to \softline
create, to reason, and to live in harmony with creation and \softline
with God.\par
}\pard \fs24\sl120\slmult1\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1   \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 Q. \ul0 \tab Why then do we live apart from God and out of harmony \softline
with creation? \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 A. \ul0 \tab From the beginning, human beings have misused their \softline
freedom and made wrong choices.\par
}\pard \fs24\sl120\slmult1\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1  \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 Q. \ul0 \tab Why do we not use our freedom as we should? \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 A. \ul0 \tab Because we rebel against God, and we put ourselves in the \softline
place of God. \par
}\pard \fs24\sl120\slmult1\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1  \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 Q. \ul0 \tab What help is there for us? \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 A. \ul0 \tab Our help is in God. \par
}\pard \fs24\sl120\slmult1\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1  \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 Q. \ul0 \tab How did God first help us? \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 A. \ul0 \tab God first helped us by revealing himself and his will, \softline
through nature and history, through many seers and \softline
saints, and especially through the prophets of Israel.\par
}\pard \fs24\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720
\column 
\pard \fs24\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720
{\plain \fs24 \b\f1 God the Father}{\plain \fs24 \f1 \par
}{\plain \fs24 \f1  \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 Q. \ul0 \tab What do we learn about God as creator from the \softline
revelation to Israel? \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 A. \ul0 \tab We learn that there is one God, the Father Almighty, \softline
creator of heaven and earth, of all that is, seen and unseen.\par
}\pard \fs24\sl120\slmult1\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1   \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 Q. \ul0 \tab What does this mean? \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 A. \ul0 \tab This means that the universe is good, that it is the work of \softline
a single loving God who creates, sustains, and directs it.\par
}\pard \fs24\sl120\slmult1\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1   \par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 Q. \ul0 \tab What does this mean about our place in the universe?\par
}\pard \fs24\fi-504\li504\tx-1440\tx-720\tx0\tx504\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
{\plain \fs24 \f1 A. \ul0 \tab It means that the world belongs to its creator; and that we \softline
