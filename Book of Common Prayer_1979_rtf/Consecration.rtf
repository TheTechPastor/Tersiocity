}{\plain \fs20 \i\f3\fs20 Psalm}{\plain \fs20 \f3\fs20    84,    }{\plain \fs20 \i\f3\fs20 or}{\plain \fs20 \f3\fs20  48 \par
}{\plain \fs20 \i\f3\fs20 Epistle}{\plain \fs20 \f3\fs20     Revelation 21:2-7,    }{\plain \fs20 \i\f3\fs20 or}{\plain \fs20 \f3\fs20  1 Corinthians 3:1-11,16-17 }{\plain \fs20 \i\f3\fs20   or}{\plain \fs20 \f3\fs20 \par
}{\plain \fs20 \f3\fs20              1 Peter 2:1-9}{\plain \fs24 \f3 \par
