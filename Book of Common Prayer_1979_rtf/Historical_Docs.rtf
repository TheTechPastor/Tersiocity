}\pard \fs16\tx0\tx306\tx1116\tx3096\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640
{\plain \fs16 \f4\fs16 (a)  The Holy Scriptures of the Old and New Testament, as {\u8220\'93}containing all things \par
}{\plain \fs16 \f4\fs16 necessary to salvation,{\u8221\'94} and as being the rule and ultimate standard of faith.\par
}\pard \fs16\sl120\slmult1\tx0\tx306\tx1116\tx3096\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640 
