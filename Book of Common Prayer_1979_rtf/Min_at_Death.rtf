\pard \fs24
{\plain \fs24 \f1 Holy Trinity, one God,\par
}{\plain \fs24 \i\f1 Have mercy on your servant.}{\plain \fs24 \f1 \par
}\pard \fs24\sl120\slmult1 
{\plain \fs24 \f1  \par
}\pard \fs24
{\plain \fs24 \f1 From all evil, from all sin, from all tribulation,\par
}{\plain \fs24 \i\f1 Good Lord, deliver }{\plain \fs24 \f1 him.\par
}\pard \fs24\sl120\slmult1 
{\plain \fs24 \f1  \par
}\pard \fs24
{\plain \fs24 \f1 By your holy Incarnation, by your Cross and Passion, by\par
}{\plain \fs24 \f1 your precious Death and Burial,\par
}{\plain \fs24 \i\f1 Good Lord, deliver}{\plain \fs24 \f1  him.\par
}\pard \fs24\sl120\slmult1 
{\plain \fs24 \f1  \par
}\pard \fs24
{\plain \fs24 \f1 By your glorious Resurrection and Ascension, and by the\par
}{\plain \fs24 \f1 Coming of the Holy Spirit,\par
}{\plain \fs24 \i\f1 Good Lord, deliver}{\plain \fs24 \f1  him.\par
}\pard \fs24\sl120\slmult1 
{\plain \fs24 \f1  \par
}\pard \fs24
{\plain \fs24 \f1 We sinners beseech you to hear us, Lord Christ: That it may\par
}{\plain \fs24 \f1 please you to deliver the soul of your servant from the power\par
}{\plain \fs24 \f1 of evil, and from eternal death,\par
}{\plain \fs24 \i\f1 We beseech you to hear us, good Lord}{\plain \fs24 \f1 .\par
}\pard \fs24\sl120\slmult1 
{\plain \fs24 \f1  \par
}\pard \fs24
{\plain \fs24 \f1 That it may please you mercifully to pardon all }{\plain \fs24 \i\f1 his}{\plain \fs24 \f1  sins,\par
}{\plain \fs24 \i\f1 We beseech you to hear us, good Lord}{\plain \fs24 \f1 .\par
}\pard \fs24\sl120\slmult1 
{\plain \fs24 \f1  \par
}\pard \fs24
{\plain \fs24 \f1 That it may please you to grant }{\plain \fs24 \i\f1 him}{\plain \fs24 \f1  a place of refreshment\par
}{\plain \fs24 \f1 and everlasting blessedness,\par
}{\plain \fs24 \i\f1 We beseech you to hear us, good Lord}{\plain \fs24 \f1 \par
}\pard \fs24\sl120\slmult1 
{\plain \fs24 \f1  \par
}\pard \fs24
{\plain \fs24 \f1 That it may please you to give }{\plain \fs24 \i\f1 him}{\plain \fs24 \f1  joy and gladness in your\par
}{\plain \fs24 \f1 kingdom, with your saints in light,\par
}{\plain \fs24 \i\f1 We beseech you to hear us, good Lord}{\plain \fs24 \f1 .\par
}\pard \fs24\sl120\slmult1 
{\plain \fs24 \f1  \par
}\pard \fs24
{\plain \fs24 \f1 Jesus, Lamb of God:\par
}{\plain \fs24 \i\f1 Have mercy on}{\plain \fs24 \f1  him.\par
}\pard \fs24\sl120\slmult1 
{\plain \fs24 \f1  \par
}\pard \fs24
{\plain \fs24 \f1 Jesus, bearer of our sins:\par
}{\plain \fs24 \i\f1 Have mercy on}{\plain \fs24 \f1  him.\par
}\pard \fs24\sl120\slmult1 
{\plain \fs24 \f1  \par
}\pard \fs24
