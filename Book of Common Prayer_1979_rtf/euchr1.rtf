}{\plain \fs24 \f3 We believe in one God,\par
}{\plain \fs24 \f3   the Father, the Almighty,\par
}{\plain \fs24 \f3   maker of heaven and earth,\par
}{\plain \fs24 \f3   of all that is, seen and unseen.\par
}\pard \fs24\sl120\slmult1\tx-720\tx612\tx972\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8532\tx9072\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
