\pard \fs48
{\plain \fs48 \f3\fs48 An Order for Celebrating\par
}{\plain \fs48 \f3\fs48 the Holy Eucharist}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22  \par
}{\plain \fs22 \f3\fs22  \par
}{\plain \fs20 \i\f3\fs20 This rite requires careful preparation by the Priest and other participants.\par
}{\plain \fs20 \i\f3\fs20  \par
}{\plain \fs20 \i\f3\fs20 It is not intended for use at the principal Sunday or weekly celebration of \par
}{\plain \fs20 \i\f3\fs20 the Holy Eucharist}{\plain \fs22 \f3\fs22 .\par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22  \par
}{\plain \fs36 \f3\fs36 The People and Priest}{\plain \fs24 \f3 \par
}\pard \fs24\sl360\slmult1 
{\plain \fs24 \f3  \par
}\pard \fs24
{\plain \fs24 \b\f3 Gather in the Lord's Name}{\plain \fs24 \f3 \par
}\pard \fs24\sl360\slmult1 
{\plain \fs24 \f3 \par
}\pard \fs24
{\plain \fs24 \b\f3 Proclaim and Respond to the Word of God}{\plain \fs24 \f3 \par
}{\plain \fs24 \f3  \par
}{\plain \fs20 \f3\fs20 The proclamation and response may include readings, song, talk, dance,\par
}{\plain \fs20 \f3\fs20 instrumental music, other art forms, silence. A reading from the Gospel\par
}{\plain \fs20 \f3\fs20 is always included}{\plain \fs22 \f3\fs22 .\par
}\pard \fs22\sl360\slmult1 
{\plain \fs22 \f3\fs22  \par
}\pard \fs22
{\plain \fs22 \b\f3\fs22 Pray for the World and the Church}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}\column 
\pard \fs22
{\plain \fs22 \b\f3\fs22 Exchange the Peace}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs20 \f3\fs20 Either here or elsewhere in the service, all greet one another in the name \par
}{\plain \fs20 \f3\fs20 of the Lord.}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \b\f3\fs22 Prepare the Table}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs20 \f3\fs20 Some of those present prepare the table; the bread, the cup of wine, and other \softline
offerings, are placed upon it.}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \b\f3\fs22 Make Eucharist}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22  \par
}{\plain \fs20 \f3\fs20 The Great Thanksgiving is said by the Priest in the name of the\par
}{\plain \fs20 \f3\fs20 gathering, using one of the eucharistic prayers provided.\par
}\pard \fs20\sl120\slmult1 
{\plain \fs20 \f3\fs20  \par
}\pard \fs22
{\plain \fs20 \f3\fs20 The people respond--Amen!}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22  \par
}{\plain \fs22 \b\f3\fs22 Break the Bread}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22  \par
}{\plain \fs22 \b\f3\fs22 Share the Gifts of God}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22  \par
}{\plain \fs20 \f3\fs20 The Body and Blood of the Lord are shared in a reverent manner; after\par
}{\plain \fs20 \f3\fs20 all have received, any of the Sacrament that remains is then consumed.}{\plain \fs22 \f3\fs22 \par
}{\plain \fs22 \f3\fs22  \par
}{\plain \fs20 \i\f3\fs20 When a common meal or Agap{\f4\u233\'e9} is a part of the celebration, it follows here}{\plain \fs22 \f3\fs22 .\par
}{\plain \fs22 \f3\fs22  \par
}{\plain \fs22 \f3\fs22  \par
}{\plain \fs22 \f3\fs22 \par
}\column 
\sect \sectd \sbknone\marglsxn1008\margrsxn792\margbsxn900\lndscpsxn\headery1440\footery1440\nocolbal\cols2\endnhere\colno1\colw6660\colsr720\colno2\colw6660\endnhere 
