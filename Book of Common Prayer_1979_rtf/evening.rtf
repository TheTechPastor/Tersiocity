}{\plain \fs20 \i\f3\fs20 The following hymn, or a metrical version of it, or some other hymn, is\par
}{\plain \fs20 \i\f3\fs20 then sung}{\plain \fs24 \f3 \par
}{\plain \fs24 \f3 \par
}{\plain \fs24 \b\f3 O Gracious Light}{\plain \fs24 \f3     }{\plain \fs24 \i\f3 Phos hilaron}{\plain \fs24 \f3 \par
}{\plain \fs24 \f3 \par
}{\plain \fs24 \f3 O gracious Light,\par
}{\plain \fs24 \f3 pure brightness of the everliving Father in heaven,\par
}{\plain \fs24 \f3 O Jesus Christ, holy and blessed! \par
}\pard \fs24\sl120\slmult1\tx-1440\tx-720\tx0\tx972\tx1422\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\tx18000\tx18720 
