\pard \fs24\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640
{\plain \fs24 \f1 We sinners do beseech thee to hear us, O Lord God; and that\par
}{\plain \fs24 \f1 it may please thee to rule and govern thy holy Church\par
}{\plain \fs24 \f1 Universal in the right way,\par
}{\plain \fs24 \i\f1 We beseech thee to hear us, good Lord.}{\plain \fs24 \f1 \par
}\pard \fs24\sl120\slmult1\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640 
{\plain \fs24 \f1  \par
}\pard \fs24\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640
{\plain \fs24 \f1 That it may please thee to illumine all bishops, priests, and\par
}{\plain \fs24 \f1 deacons, with true knowledge and understanding of thy\par
}{\plain \fs24 \f1 Word; and that both by their preaching and living, they may\par
}{\plain \fs24 \f1 set it forth, and show it accordingly,\par
}{\plain \fs24 \i\f1 We beseech thee to hear us, good Lord.}{\plain \fs24 \f1 \par
}\pard \fs24\sl120\slmult1\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640 
{\plain \fs24 \f1  \par
}\pard \fs24\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640
{\plain \fs24 \f1 That it may please thee to bless and keep all thy people,\par
}{\plain \fs24 \i\f1 We beseech thee to hear us, good Lord.}{\plain \fs24 \f1 \par
}\pard \fs24\sl120\slmult1\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640 
{\plain \fs24 \f1  \par
}\pard \fs24\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640
{\plain \fs24 \f1 That it may please thee to send forth laborers into thy\par
}{\plain \fs24 \f1 harvest, and to draw all mankind into thy kingdom,\par
}{\plain \fs24 \i\f1 We beseech thee to hear us, good Lord.}{\plain \fs24 \f1 \par
}\pard \fs24\sl120\slmult1\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640 
{\plain \fs24 \f1  \par
}\pard \fs24\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640
{\plain \fs24 \f1 That it may please thee to give to all people increase of grace\par
}{\plain \fs24 \f1 to hear and receive thy Word, and to bring forth the fruits of\par
}{\plain \fs24 \f1 the Spirit,\par
}{\plain \fs24 \i\f1 We beseech thee to hear us, good Lord.}{\plain \fs24 \f1 \par
}\pard \fs24\sl120\slmult1\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640 
{\plain \fs24 \f1  \par
}\pard \fs24\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640
{\plain \fs24 \f1 That it may please thee to bring into the way of truth all such\par
}{\plain \fs24 \f1 as have erred, and are deceived,\par
}{\plain \fs24 \i\f1 We beseech thee to hear us, good Lord.}{\plain \fs24 \f1 \par
}\pard \fs24\sl120\slmult1\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640 
{\plain \fs24 \f1  \par
}\pard \fs24\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640
{\plain \fs24 \f1 That it may please thee to give us a heart to love and fear\par
}{\plain \fs24 \f1 thee, and diligently to live after thy commandments,\par
}{\plain \fs24 \i\f1 We beseech thee to hear us, good Lord.}{\plain \fs24 \f1 \par
}\pard \fs24\sl120\slmult1\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640 
{\plain \fs24 \f1  \par
}\pard \fs24\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640
{\plain \fs24 \f1 That it may please thee so to rule the hearts of thy servants,\par
}{\plain \fs24 \f1 the President of the United States (}{\plain \fs24 \i\f1 or}{\plain \fs24 \f1  of this nation), and all\par
}{\plain \fs24 \f1 others in authority, that they may do justice, and love mercy,\par
}{\plain \fs24 \f1 and walk in the ways of truth,\par
}{\plain \fs24 \i\f1 We beseech thee to hear us, good Lord.}{\plain \fs24 \f1 \par
}{\plain \fs24 \f1  \par
}{\plain \fs24 \f1 \par
}\column 
\pard \fs24\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640
{\plain \fs24 \f1 That it may please thee to make wars to cease in all the world;\par
}{\plain \fs24 \f1 to give to all nations unity, peace, and concord; and to\par
}{\plain \fs24 \f1 bestow freedom upon all peoples,\par
}{\plain \fs24 \i\f1 We beseech thee to hear us, good Lord.}{\plain \fs24 \f1 \par
}\pard \fs24\sl120\slmult1\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640 
{\plain \fs24 \f1  \par
}\pard \fs24\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640
{\plain \fs24 \f1 That it may please thee to show thy pity upon all prisoners\par
}{\plain \fs24 \f1 and captives, the homeless and the hungry, and all who are\par
}{\plain \fs24 \f1 desolate and oppressed,\par
}{\plain \fs24 \i\f1 We beseech thee to hear us, good Lord.}{\plain \fs24 \f1 \par
}\pard \fs24\sl120\slmult1\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640 
{\plain \fs24 \f1  \par
}\pard \fs24\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640
{\plain \fs24 \f1 That it may please thee to give and preserve to our use the\par
}{\plain \fs24 \f1 bountiful fruits of the earth, so that in due time all may enjoy\par
}{\plain \fs24 \f1 them,\par
}{\plain \fs24 \i\f1 We beseech thee to hear us, good Lord.}{\plain \fs24 \f1 \par
}\pard \fs24\sl120\slmult1\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640 
{\plain \fs24 \f1  \par
}\pard \fs24\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640
{\plain \fs24 \f1 That it may please thee to inspire us, in our several callings,\par
}{\plain \fs24 \f1 to do the work which thou givest us to do with singleness of\par
}{\plain \fs24 \f1 heart as thy servants, and for the common good,\par
}{\plain \fs24 \i\f1 We beseech thee to hear us, good Lord.}{\plain \fs24 \f1 \par
}\pard \fs24\sl120\slmult1\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640 
{\plain \fs24 \f1  \par
}\pard \fs24\tx0\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640
{\plain \fs24 \f1 That it may please thee to preserve all who are in danger by\par
}{\plain \fs24 \f1 reason of their labor or their travel,\par
}{\plain \fs24 \i\f1 We beseech thee to hear us, good Lord}{\plain \fs24 \f1 .\par
