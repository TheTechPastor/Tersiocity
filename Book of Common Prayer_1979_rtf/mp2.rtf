}{\plain \fs24 \f3 reach to the end of the earth.  }{\plain \fs20 \i\f3\fs20 Isaiah 49:6b}{\plain \fs24 \f3 \par
}\pard \fs24\sl120\slmult1 
{\plain \fs24 \f3 \par
}\pard \fs24
